description="GO Simple Tunnel"

: "${GOST_CONFIG:=/etc/gost/gost.yml}"

command="/usr/bin/gost"
command_args="-C ${GOST_CONFIG} ${GOST_OPTS}"
command_user="gost:gost"
supervisor="supervise-daemon"
respawn_delay=5

depend() {
	need net
	after firewall
}

start_pre() {
	if [ ! -r "${GOST_CONFIG}" ]; then
		eerror "Config ${GOST_CONFIG} not found"
		eerror "See /etc/gost/gost.yml.example"
		return 1
	fi
}
